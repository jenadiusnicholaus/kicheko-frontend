VITE_APP_GTM_KEY=

VITE_APP_INCLUDE_DEMOS=

VITE_APP_ROUTER_MODE_HISTORY=

VITE_APP_BUILD_VERSION=

# Kicheko API — base URL and endpoint paths.
# Dev: requests go to VITE_API_BASE_URL (same-origin) and the Vite proxy
# forwards them to VITE_API_PROXY_TARGET — the real backend.
# Prod: requests go directly to VITE_API_PROXY_TARGET + VITE_API_BASE_URL,
# e.g. https://api.taifahouse.tz/api/v1 (values live in .env.production).
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_PREFIX=/api
VITE_API_PROXY_TARGET=http://127.0.0.1:8023
VITE_API_AUTH_REGISTER=/auth/register/
VITE_API_AUTH_TOKEN=/auth/token/
VITE_API_AUTH_TOKEN_REFRESH=/auth/token/refresh/
VITE_API_AUTH_TOKEN_VERIFY=/auth/token/verify/
VITE_API_AUTH_PASSWORD_RESET=/auth/password-reset/
VITE_API_AUTH_PASSWORD_RESET_VERIFY=/auth/password-reset/verify/
VITE_API_AUTH_PASSWORD_RESET_CONFIRM=/auth/password-reset/confirm/
VITE_API_AUTH_ME=/auth/me/

VITE_API_AUTH_PASSWORD_RESET_CONFIRM=/auth/password-reset/confirm/
VITE_API_AUTH_ME=/auth/me/
VITE_PAYIT_SLUG=taifa-house
VITE_API_AUTH_GOOGLE=/auth/google/
